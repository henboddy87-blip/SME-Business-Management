# ==========================================
# Backend .gitignore - Python / FastAPI
# ==========================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
env/
.venv/
.env

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# SQLite database files
*.db
*.sqlite3

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Alembic auto-generated (keep versions)
# alembic/versions/ is tracked, but __pycache__ is not

# Logs
*.log

# IDE
.vscode/
.idea/
